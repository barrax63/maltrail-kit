# Role of this host:
#   server  -> reporting UI + nginx + this host's own sensor
#   (empty) -> sensor only, reporting to LOG_SERVER (set in config/maltrail.local.conf)
COMPOSE_PROFILES=server

# Upstream checkout used as build context and for the default maltrail.conf.
# Relative to this folder.
MALTRAIL_SRC=../maltrail

TZ=Europe/Berlin

# ---- server host only ------------------------------------------------------

# Host port where nginx exposes the HTTPS UI
NGINX_PORT=4098

# Host address/port for the event intake from remote sensors (container port
# 8337/udp is fixed in config/maltrail.kit.conf). Docker-published ports bypass
# ufw/firewalld: prefer the address the sensors reach this host on (LAN or
# WireGuard IP) over 0.0.0.0.
EVENTS_UDP_BIND=0.0.0.0
EVENTS_UDP_PORT=8337
